<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GDS">
	<parameter name="URL" value="gdsuat/"/>
	<parameter name="username" value="vvoona1"/>
	<test name="Forms" >
	<parameter name="URL" value="gdsuat/forms"/>
	<groups>
		<run>
			<include name="regression"/>
		</run>
	</groups>
		<classes>
			<class name="Components.Checkbox"/>
			<class name="Components.Dropdown"/>
		</classes>
	</test>
	<test name="Actions">
	<parameter name="URL" value="gdsuat/actions"/>
	<groups>
		<run>
			<include name="smoke"></include>
		</run>
	</groups>
		<classes>
			<class name="Components.Buttons"/>
			<class name="Components.FAB"/>
		</classes>
	</test>
	<test name="Patterns">
		<packages>
			<package name="Patterns"/>
		</packages>
	</test>
</suite>
